<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario para abrir el socket del servidor local (127.0.0.1) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Hace visibles las apps de música (Android 11+) para mostrar su nombre -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_media_play"
        android:label="Mando Música (dev)"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El sistema enlaza este servicio cuando se concede el acceso a notificaciones.
             Es lo que permite leer y controlar las sesiones multimedia de otras apps. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="Mando Música"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
